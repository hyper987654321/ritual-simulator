		{ AtTick = 0, AtSeconds = 0, EmitterId = "plume_center_stream", Kind = "emit", Count = 3 },
		{ AtTick = 0, AtSeconds = 0, EmitterId = "plume_left_stream", Kind = "emit", Count = 2 },
		{ AtTick = 0, AtSeconds = 0, EmitterId = "plume_right_stream", Kind = "emit", Count = 2 },
		{ AtTick = 720, AtSeconds = 3, EmitterId = "body_orbit", Kind = "disable" },
		{ AtTick = 720, AtSeconds = 3, EmitterId = "body_sparks", Kind = "disable" },
		{ AtTick = 720, AtSeconds = 3, EmitterId = "crown_orbit", Kind = "disable" },
		{ AtTick = 720, AtSeconds = 3, EmitterId = "ground_blades_counter", Kind = "disable" },
		{ AtTick = 720, AtSeconds = 3, EmitterId = "ground_blades_primary", Kind = "disable" },
		{ AtTick = 720, AtSeconds = 3, EmitterId = "ground_heartbeat", Kind = "disable" },
		{ AtTick = 720, AtSeconds = 3, EmitterId = "lightning_left", Kind = "disable" },
		{ AtTick = 720, AtSeconds = 3, EmitterId = "lightning_right", Kind = "disable" },
