function Definition.ValidateAssetBindings(assetBindings)
	if assetBindings == nil then
		assetBindings = Definition.AssetBindings
	end
	local resolved = {}
	local problems = {}
	local expected = {}
	for _, textureKey in ipairs(Definition.Registry.TextureKeys) do
		expected[textureKey] = true
		local contentId, problem = normalizeAssetBinding(assetBindings[textureKey])
		if contentId then
			resolved[textureKey] = contentId
		else
			table.insert(problems, textureKey .. ": " .. problem)
		end
	end
	for textureKey in assetBindings do
		if type(textureKey) ~= "string" or expected[textureKey] ~= true then
			table.insert(problems, "unknown texture binding: " .. tostring(textureKey))
		end
	end
	table.sort(problems)
	return resolved, problems
end


function Definition.CreateTemplate(assetBindings, options)
	options = options or {}
	local resolvedTextures, bindingProblems = Definition.ValidateAssetBindings(assetBindings)
	if #bindingProblems > 0 and options.allowUnresolvedTextures ~= true then
		error("missing or invalid Roblox texture bindings for " .. Definition.Registry.EffectName .. ": " .. table.concat(bindingProblems, "; "), 2)
	end

	local root = Instance.new("Folder")
	root.Name = Definition.Registry.TemplateName
	root:SetAttribute("VFXGenerated", true)
	root:SetAttribute("VFXEffectId", Definition.Registry.EffectName)
	root:SetAttribute("VFXSourceFingerprint", Definition.Registry.SourceEffectFingerprint)
	root:SetAttribute("VFXPackagedFingerprint", Definition.Registry.PackagedEffectFingerprint)
	root:SetAttribute("VFXCompiledFingerprint", Definition.Registry.CompiledFingerprint)
	root:SetAttribute("VFXCompilerVersion", Definition.CompilerVersion)
	root:SetAttribute("VFXSeed", Definition.Registry.Seed)
	root:SetAttribute("VFXStyle", Definition.Registry.Style)
	root:SetAttribute("VFXDurationSeconds", Definition.Registry.DurationSeconds)
	root:SetAttribute("VFXCleanupTick", Definition.Registry.CleanupTick)
	root:SetAttribute("VFXCleanupSeconds", Definition.Registry.CleanupSeconds)
	root:SetAttribute("VFXPoolingReady", Definition.Registry.PoolingReady)

	local anchors = {}
	local remaining = #Definition.Anchors
	while remaining > 0 do
		local created = 0
		for _, anchorDefinition in ipairs(Definition.Anchors) do
			if anchors[anchorDefinition.AnchorId] == nil then
				local parent = root
				if anchorDefinition.ParentAnchorId ~= nil then
					parent = anchors[anchorDefinition.ParentAnchorId]
				end
				if parent ~= nil then
					local anchor = Instance.new("Attachment")
					anchor.Name = anchorDefinition.InstanceName
					anchor.CFrame = transformCFrame(anchorDefinition.LocalTransform)
					anchor:SetAttribute("VFXGenerated", true)
					anchor:SetAttribute("VFXStableKey", "anchor:" .. anchorDefinition.AnchorId)
					anchor:SetAttribute("VFXAnchorId", anchorDefinition.AnchorId)
					anchor.Parent = parent
					anchors[anchorDefinition.AnchorId] = anchor
					created += 1
				end
			end
		end
		if created == 0 then
			error("compiled anchor hierarchy is cyclic or references a missing parent", 2)
		end
		remaining -= created
	end

	for _, emitterDefinition in ipairs(Definition.Emitters) do
		local anchor = anchors[emitterDefinition.AnchorId]
		local source: Instance = anchor
		local volumeDefinition = emitterDefinition.SourceVolume
		if volumeDefinition ~= nil then
			local volume = Instance.new("Part")
			volume.Name = volumeDefinition.InstanceName
			volume.Size = Vector3.new(volumeDefinition.Size[1], volumeDefinition.Size[2], volumeDefinition.Size[3])
			volume.Transparency = 1
			volume.Anchored = true
			volume.CanCollide = false
			volume.CanQuery = false
			volume.CanTouch = false
			volume.CastShadow = false
			volume:SetAttribute("VFXGenerated", true)
			volume:SetAttribute("VFXStableKey", "source_volume:" .. emitterDefinition.EmitterId)
			volume:SetAttribute("VFXSourceEmitterId", emitterDefinition.EmitterId)
			volume:SetAttribute("VFXSourceAnchorId", emitterDefinition.AnchorId)
			volume:SetAttribute("VFXSourceRotationDegreesXYZ", Vector3.new(volumeDefinition.RotationDegreesXYZ[1], volumeDefinition.RotationDegreesXYZ[2], volumeDefinition.RotationDegreesXYZ[3]))
			volume:SetAttribute("VFXQualityRole", emitterDefinition.QualityRole)
			volume.Parent = root
			source = volume
		end
		local emitter = Instance.new("ParticleEmitter")
		emitter.Name = emitterDefinition.InstanceName
		emitter.Enabled = emitterDefinition.TemplateEnabled
		emitter.Rate = emitterDefinition.Rate
		emitter.Lifetime = numberRange(emitterDefinition.Lifetime)
		emitter.Speed = numberRange(emitterDefinition.Speed)
		emitter.Acceleration = Vector3.new(emitterDefinition.Acceleration[1], emitterDefinition.Acceleration[2], emitterDefinition.Acceleration[3])
		emitter.Drag = emitterDefinition.Drag
		emitter.SpreadAngle = Vector2.new(emitterDefinition.SpreadAngle[1], emitterDefinition.SpreadAngle[2])
		emitter.Rotation = numberRange(emitterDefinition.Rotation)
		emitter.RotSpeed = numberRange(emitterDefinition.RotSpeed)
		emitter.Squash = numberSequence(emitterDefinition.Squash)
		emitter.TimeScale = emitterDefinition.TimeScale
		emitter.VelocityInheritance = emitterDefinition.VelocityInheritance
		emitter.Size = numberSequence(emitterDefinition.Size)
		emitter.Transparency = numberSequence(emitterDefinition.Transparency)
		emitter.Color = colorSequence(emitterDefinition.Color)
		emitter.LightEmission = emitterDefinition.LightEmission
		emitter.LightInfluence = emitterDefinition.LightInfluence
		emitter.Brightness = emitterDefinition.Brightness
		emitter.FlipbookLayout = FLIPBOOK_LAYOUT[emitterDefinition.FlipbookLayout]
		emitter.FlipbookMode = FLIPBOOK_MODE[emitterDefinition.FlipbookMode]
		if emitterDefinition.FlipbookMode ~= "OneShot" then
			emitter.FlipbookFramerate = numberRange(emitterDefinition.FlipbookFramerate)
		end
		emitter.FlipbookStartRandom = emitterDefinition.FlipbookStartRandom
		emitter.FlipbookBlendFrames = emitterDefinition.FlipbookBlendFrames
		emitter.Orientation = ORIENTATION[emitterDefinition.Orientation]
		emitter.EmissionDirection = EMISSION_DIRECTION[emitterDefinition.EmissionDirection]
		if volumeDefinition ~= nil then
			emitter.Shape = PARTICLE_SHAPE[volumeDefinition.Shape]
			emitter.ShapeStyle = PARTICLE_SHAPE_STYLE[volumeDefinition.Style]
			emitter.ShapeInOut = PARTICLE_SHAPE_IN_OUT[volumeDefinition.InOut]
			emitter.ShapePartial = volumeDefinition.ShapePartial
		end
		emitter.LockedToPart = emitterDefinition.LockedToPart
		emitter.ZOffset = emitterDefinition.ZOffset
		emitter:SetAttribute("VFXGenerated", true)
		emitter:SetAttribute("VFXStableKey", "emitter:" .. emitterDefinition.EmitterId)
		emitter:SetAttribute("VFXEmitterId", emitterDefinition.EmitterId)
		emitter:SetAttribute("VFXTextureKey", emitterDefinition.TextureKey)
		emitter:SetAttribute("VFXConfiguredEnabled", emitterDefinition.ConfiguredEnabled)
		emitter:SetAttribute("VFXQualityRole", emitterDefinition.QualityRole)
		local texture = resolvedTextures[emitterDefinition.TextureKey]
		if texture then emitter.Texture = texture; emitter:SetAttribute("VFXTextureUnresolved", false) else emitter:SetAttribute("VFXTextureUnresolved", true) end
		emitter.Parent = source
	end

	for _, beamDefinition in ipairs(Definition.Beams) do
		local beam = Instance.new("Beam")
		beam.Name = beamDefinition.InstanceName
		beam.Enabled = beamDefinition.TemplateEnabled
		beam.Attachment0 = anchors[beamDefinition.Attachment0AnchorId]
		beam.Attachment1 = anchors[beamDefinition.Attachment1AnchorId]
		beam.CurveSize0 = beamDefinition.CurveSize0
		beam.CurveSize1 = beamDefinition.CurveSize1
		beam.Width0 = beamDefinition.Width0
		beam.Width1 = beamDefinition.Width1
		beam.Segments = beamDefinition.Segments
		beam.TextureMode = TEXTURE_MODE[beamDefinition.TextureMode]
		beam.TextureLength = beamDefinition.TextureLength
		beam.TextureSpeed = beamDefinition.TextureSpeed
		beam.Color = colorSequence(beamDefinition.Color)
		beam.Transparency = numberSequence(beamDefinition.Transparency)
		beam.FaceCamera = beamDefinition.FaceCamera
		beam.LightEmission = beamDefinition.LightEmission
		beam.LightInfluence = beamDefinition.LightInfluence
		beam.Brightness = beamDefinition.Brightness
		beam.ZOffset = beamDefinition.ZOffset
		beam:SetAttribute("VFXGenerated", true)
		beam:SetAttribute("VFXStableKey", "beam:" .. beamDefinition.BeamId)
		beam:SetAttribute("VFXBeamId", beamDefinition.BeamId)
		beam:SetAttribute("VFXTextureKey", beamDefinition.TextureKey)
		beam:SetAttribute("VFXConfiguredEnabled", beamDefinition.ConfiguredEnabled)
		beam:SetAttribute("VFXQualityRole", beamDefinition.QualityRole)
		local texture = resolvedTextures[beamDefinition.TextureKey]
		if texture then beam.Texture = texture; beam:SetAttribute("VFXTextureUnresolved", false) else beam:SetAttribute("VFXTextureUnresolved", true) end
		beam.Parent = root
	end

	for _, trailDefinition in ipairs(Definition.Trails) do
		local trail = Instance.new("Trail")
		trail.Name = trailDefinition.InstanceName
		trail.Enabled = trailDefinition.TemplateEnabled
		trail.Attachment0 = anchors[trailDefinition.Attachment0AnchorId]
		trail.Attachment1 = anchors[trailDefinition.Attachment1AnchorId]
		trail.Lifetime = trailDefinition.Lifetime
		trail.MinLength = trailDefinition.MinLength
		trail.MaxLength = trailDefinition.MaxLength
		trail.WidthScale = numberSequence(trailDefinition.WidthScale)
		trail.TextureMode = TEXTURE_MODE[trailDefinition.TextureMode]
		trail.TextureLength = trailDefinition.TextureLength
		trail.Color = colorSequence(trailDefinition.Color)
		trail.Transparency = numberSequence(trailDefinition.Transparency)
		trail.FaceCamera = trailDefinition.FaceCamera
		trail.LightEmission = trailDefinition.LightEmission
		trail.LightInfluence = trailDefinition.LightInfluence
		trail.Brightness = trailDefinition.Brightness
		trail:SetAttribute("VFXGenerated", true)
		trail:SetAttribute("VFXStableKey", "trail:" .. trailDefinition.TrailId)
		trail:SetAttribute("VFXTrailId", trailDefinition.TrailId)
		trail:SetAttribute("VFXConfiguredEnabled", trailDefinition.ConfiguredEnabled)
		trail:SetAttribute("VFXQualityRole", trailDefinition.QualityRole)
		if trailDefinition.TextureKey ~= nil then
			trail:SetAttribute("VFXTextureKey", trailDefinition.TextureKey)
			local texture = resolvedTextures[trailDefinition.TextureKey]
			if texture then trail.Texture = texture; trail:SetAttribute("VFXTextureUnresolved", false) else trail:SetAttribute("VFXTextureUnresolved", true) end
		else
			trail:SetAttribute("VFXTextureUnresolved", false)
		end
		trail.Parent = root
	end

	for _, lightDefinition in ipairs(Definition.Lights) do
		local light = Instance.new("PointLight")
		light.Name = lightDefinition.InstanceName
		light.Enabled = lightDefinition.TemplateEnabled
		light.Color = Color3.fromRGB(lightDefinition.Color[1], lightDefinition.Color[2], lightDefinition.Color[3])
		light.Brightness = lightDefinition.Brightness
		light.Range = lightDefinition.Range
		light.Shadows = lightDefinition.Shadows
		light:SetAttribute("VFXGenerated", true)
		light:SetAttribute("VFXStableKey", "light:" .. lightDefinition.LightId)
		light:SetAttribute("VFXLightId", lightDefinition.LightId)
		light:SetAttribute("VFXConfiguredEnabled", lightDefinition.ConfiguredEnabled)
		light:SetAttribute("VFXQualityRole", lightDefinition.QualityRole)
		light.Parent = anchors[lightDefinition.AnchorId]
	end

	for _, lightDefinition in ipairs(Definition.SpotLights) do
		local light = Instance.new("SpotLight")
		light.Name = lightDefinition.InstanceName
		light.Enabled = lightDefinition.TemplateEnabled
		light.Face = EMISSION_DIRECTION[lightDefinition.Face]
		light.Color = Color3.fromRGB(lightDefinition.Color[1], lightDefinition.Color[2], lightDefinition.Color[3])
		light.Brightness = lightDefinition.Brightness
		light.Range = lightDefinition.Range
		light.Angle = lightDefinition.Angle
		light.Shadows = lightDefinition.Shadows
		light:SetAttribute("VFXGenerated", true)
		light:SetAttribute("VFXStableKey", "spot_light:" .. lightDefinition.LightId)
		light:SetAttribute("VFXLightId", lightDefinition.LightId)
		light:SetAttribute("VFXConfiguredEnabled", lightDefinition.ConfiguredEnabled)
		light:SetAttribute("VFXQualityRole", lightDefinition.QualityRole)
		light.Parent = anchors[lightDefinition.AnchorId]
	end

	return root, bindingProblems
end

return table.freeze(Definition)
