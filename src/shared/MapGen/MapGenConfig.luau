local function copyTable(source)
	local result = {}

	for key, value in pairs(source) do
		result[key] = if typeof(value) == "table" then copyTable(value) else value
	end

	return result
end

local function mergeTable(base, overlay)
	local result = copyTable(base)

	for key, value in pairs(overlay) do
		if typeof(value) == "table" and typeof(result[key]) == "table" then
			result[key] = mergeTable(result[key], value)
		else
			result[key] = if typeof(value) == "table" then copyTable(value) else value
		end
	end

	return result
end

function MapGenConfig.getPreset(presetName)
	return MapGenConfig.Presets[presetName] or MapGenConfig.Presets[MapGenConfig.DefaultPreset]
end

function MapGenConfig.getPropSet(propSetName)
	return MapGenConfig.PropSets[propSetName] or MapGenConfig.PropSets.Starter
end

function MapGenConfig.getZoneTheme(zoneId)
	local exactTheme = MapGenConfig.ZoneThemes[zoneId]

	if exactTheme ~= nil then
		return exactTheme
	end

	local cycle = MapGenConfig.FallbackThemeCycle
	local cycleTheme = cycle[((zoneId - 1) % #cycle) + 1]
	local theme = mergeTable(MapGenConfig.ZoneThemes[1], cycleTheme)

	theme.DisplayTheme = theme.DisplayTheme .. " Stage " .. tostring(zoneId)

	return theme
end

return MapGenConfig
